# Supabase (service role — jangan pernah expose ke browser)
NEXT_PUBLIC_SUPABASE_URL=https://urfkqcdwcvyzctbtbpwv.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxx

# R2 / S3-compatible storage
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_BUCKET=videos
R2_PUBLIC_URL=https://cdn.playly.id

# Optional: override path ffmpeg binary
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# HTTP server port (Render/Fly/Railway override via env PORT)
PORT=3000

# Secret untuk webhook /process (opsional tapi direkomendasikan)
WEBHOOK_SECRET=change-me-to-random-string

# Polling interval dalam milidetik (default 10000)
POLL_INTERVAL_MS=10000
