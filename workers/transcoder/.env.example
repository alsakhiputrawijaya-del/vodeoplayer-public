# Konfigurasi worker transcoder. SALIN ke `.env` lalu isi nilai aslinya di sana
# — berkas `.env.example` ini IKUT MASUK GIT, jadi isinya wajib placeholder.

# Supabase — service role (menembus RLS; jangan pernah dikirim ke browser).
# Harus project yang SAMA dengan aplikasi Next.js, kalau tidak worker memantau
# antrian job di database yang salah dan tak pernah menemukan pekerjaan.
NEXT_PUBLIC_SUPABASE_URL=https://lmeepqunciyrfshlqfeu.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# Storage: Supabase Storage S3-compatible — tempat file asli dibaca & hasil
# transcode diunggah. Tanpa S3_ENDPOINT worker tidak tahu harus konek ke mana.
S3_ENDPOINT=https://lmeepqunciyrfshlqfeu.storage.supabase.co
S3_REGION=ap-southeast-2
S3_ACCESS_KEY_ID=xxx
S3_SECRET_ACCESS_KEY=xxx
S3_BUCKET=videos

# Cloudflare R2 sudah TIDAK dipakai. Kode worker masih menerima R2_ACCOUNT_ID /
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY / R2_BUCKET / R2_PUBLIC_URL sebagai
# fallback untuk deployment lama — jangan diisi kecuali memang kembali ke R2.

# Optional: override path binary ffmpeg. Dikosongkan = pakai ffmpeg-static
# yang ikut terpasang lewat npm install.
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# Port HTTP server (Render/Fly/Railway/Koyeb menimpa lewat env PORT).
PORT=3000

# Secret untuk webhook POST /process (opsional tapi direkomendasikan).
# Harus sama dengan TRANSCODER_WEBHOOK_SECRET di app Next.js.
WEBHOOK_SECRET=change-me-to-random-string

# Interval polling antrian job, milidetik (cadangan kalau webhook tidak sampai).
POLL_INTERVAL_MS=10000
