# Rename file ini menjadi .env (bukan .env.local) di folder workers/transcoder,
# lalu isi semua value.
#
# Cara isi: copy value dari Environment Variables yang sudah kamu isi di Render,
# lalu paste ke bawah ini.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://urfkqcdwcvyzctbtbpwv.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxx

# --- Storage: Supabase Storage S3 ---
S3_ENDPOINT=https://<project_ref>.storage.supabase.co/storage/s3
S3_REGION=ap-southeast-2
S3_ACCESS_KEY_ID=xxx
S3_SECRET_ACCESS_KEY=xxx
S3_BUCKET=videos
# S3_PUBLIC_URL opsional — kalau kosong akan dibangun otomatis dari S3_ENDPOINT
# S3_PUBLIC_URL=https://<project_ref>.storage.supabase.co/storage/v1/object/public/videos

# --- Worker ---
PORT=3000
POLL_INTERVAL_MS=10000
WEBHOOK_SECRET=playly-webhook-2026
