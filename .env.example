# Copy file ini ke .env.local untuk development.
# Untuk production, set variables di dashboard Vercel.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://urfkqcdwcvyzctbtbpwv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxx
SUPABASE_SERVICE_ROLE_KEY=xxx

# Storage: Supabase Storage S3-compatible (primary) atau Cloudflare R2 (legacy)
# Supabase Storage S3
S3_ENDPOINT=https://<project_ref>.s3.<region>.supabase.co
S3_ACCESS_KEY_ID=xxx
S3_SECRET_ACCESS_KEY=xxx
S3_BUCKET=videos
# Optional: kalau tidak di-set, public URL akan otomatis dibangun dari NEXT_PUBLIC_SUPABASE_URL
# S3_PUBLIC_URL=https://<project_ref>.supabase.co/storage/v1/object/public/videos

# R2 (Cloudflare) — fallback bila S3_* tidak di-set
R2_ACCOUNT_ID=xxx
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_BUCKET=videos
R2_PUBLIC_URL=https://cdn.playly.id

# Transcoder worker webhook (opsional tapi direkomendasikan)
# Ini URL public worker kamu, misal https://playly-transcoder.onrender.com/process
TRANSCODER_WEBHOOK_URL=
# Secret yang sama dengan WEBHOOK_SECRET di worker
TRANSCODER_WEBHOOK_SECRET=change-me-to-random-string
